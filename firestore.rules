
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is an admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.email.endsWith('@hobolivings.com') ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }

    match /users/{userId} {
      // Allow anyone to read user profiles
      allow read: if true;
      
      // Allow a user to create their own profile upon signup
      allow create: if request.auth != null && request.auth.uid == userId;

      // Allow a logged-in user or admin to update profile
      allow update: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      
      // Allow admin to delete user profiles
      allow delete: if isAdmin();
    }

    match /properties/{propertyId} {
      // Anyone can read property listings
      allow read: if true;

      // An authenticated 'owner' can create a property
      allow create: if request.auth != null &&
                      get(/databases/$(database)/documents/users/$(request.auth.uid)).data.profileType == 'owner' &&
                      request.resource.data.ownerId == request.auth.uid;

      // The owner or admin can update/delete property
      allow update, delete: if (request.auth != null && request.auth.uid == resource.data.ownerId) || isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /support_tickets/{ticketId} {
      allow read, write: if request.auth != null;
    }

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if request.auth != null; // Allow clients to record audit logs on admin actions
    }
  }
}
